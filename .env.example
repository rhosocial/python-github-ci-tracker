# CI Tracker 环境变量样例
#
# 复制为 `.env` 并按需修改（`.env` 已在 .gitignore 中，不会提交）。
# 加载方式：服务启动前由启动脚本 `source .env` / `dotenv` 注入，或直接在环境中导出。
# Python 侧不需要读这个文件本身——所有变量都由 infrastructure.config.Settings 读取。

# ---------------------------------------------------------------------------
# GitHub 令牌（必填）
# ---------------------------------------------------------------------------
# Fine-grained PAT。需要的权限：
#   Repository permissions -> Actions: Read and write   （触发 CI、读取结果）
#                           -> Metadata: Read            （必须）
#   Repository permissions -> Administration: Read and write（创建/管理 Webhook，可选）
# 令牌只存入数据库，不落盘、不打印。
GITHUB_FINE_GRAINED_TOKEN=

# ---------------------------------------------------------------------------
# 对外监听端口（Webhook 入口）
# ---------------------------------------------------------------------------
# Webhook 接收端监听的主机与端口。改这里即可整体迁移，无需改代码。
CITRACKER_WEBHOOK_HOST=0.0.0.0
CITRACKER_WEBHOOK_PORT=18080

# GitHub 上配置 Webhook 时使用的完整回调 URL（创建 Webhook 时的默认值）。
# 必须是外网可达的地址；端口需与 CITRACKER_WEBHOOK_PORT 一致。
CITRACKER_WEBHOOK_URL=http://db-dev-1-n.rho.im:18080/webhooks/github

# Webhook 签名密钥。GitHub 用它计算 X-Hub-Signature-256，服务端用它验签。
# 必须是非空随机字符串；留空则跳过验签（仅限本地调试）。
CITRACKER_WEBHOOK_SECRET=

# REST API 监听地址（默认与 Webhook 同应用，仅端口不同）
CITRACKER_REST_HOST=0.0.0.0
CITRACKER_REST_PORT=8000

# MCP Server 监听地址
CITRACKER_MCP_HOST=0.0.0.0
CITRACKER_MCP_PORT=8001

# ---------------------------------------------------------------------------
# API Key 认证
# ---------------------------------------------------------------------------
# REST / MCP 的接口 API Key。CLI 不要求它（本地操作由数据库访问授权）。
# 两者都以 Authorization: Bearer <key> 校验。留空时都不鉴权，启动日志会告警；
# 本机/内网可用，公网部署必须由部署者提供该 key。
# Webhook 接收端不使用这个 key，它用 CITRACKER_WEBHOOK_SECRET 做 HMAC 验签。
CITRACKER_API_KEY=

# ---------------------------------------------------------------------------
# 数据库（默认对应 postgres_18 测试场景）
# ---------------------------------------------------------------------------
CITRACKER_DB_HOST=192.168.1.3
CITRACKER_DB_PORT=16689
CITRACKER_DB_NAME=test_db
CITRACKER_DB_USER=root
CITRACKER_DB_PASSWORD=password
CITRACKER_DB_SSLMODE=prefer

# 连接池大小
CITRACKER_POOL_MIN=1
CITRACKER_POOL_MAX=10

# ---------------------------------------------------------------------------
# 容器首次启动（docker/init.d，compose 的 init 服务）
# ---------------------------------------------------------------------------
# 首次启动时 init 执行 docker/init.d/10-schema.sh 建库建表、20-pat.sh 注入 PAT。
# 设置该 PAT 后：不存在则新增，已存在则原地轮换，并由 GitHub 校验。
# 文件形式可避免令牌出现在 docker inspect：CITRACKER_BOOTSTRAP_PAT_FILE=/run/secrets/citracker-pat
CITRACKER_BOOTSTRAP_PAT=
CITRACKER_BOOTSTRAP_PAT_NAME=default
CITRACKER_BOOTSTRAP_PROBE_REPO=
# 自行管理 schema 与凭据的 legacy 部署：置 CITRACKER_INITDB=skip（或 CITRACKER_LEGACY=1）。
CITRACKER_LEGACY=0

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
# 默认订阅的 Webhook 事件（逗号分隔）
CITRACKER_DEFAULT_EVENTS=workflow_run,workflow_job

# 单次 wait_for_run 可等待的上限，单位秒
CITRACKER_WAIT_MAX_SECONDS=300

# 跳过 trigger 的 allowlist：任何已订阅仓库、任何 workflow、任何 ref 都可触发，
# 前提是凭据具备 Actions 写权限。默认 0。
# 打开后 agent 可以触发 publish 这类会发版的 workflow，也能在任意分支烧 CI 分钟；
# 单用户自托管、且 fine-grained PAT 本身就是授权时，才建议打开。
CITRACKER_TRIGGER_ALLOW_ALL=0

# 日志级别（DEBUG / INFO / WARNING / ERROR）
CITRACKER_LOG_LEVEL=INFO
