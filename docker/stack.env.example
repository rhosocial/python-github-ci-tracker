# docker/stack.env -- passed to compose with:
#   docker compose --env-file docker/stack.env up -d
# This file is git-ignored. Interpolation values only: they configure the
# compose files, while the app's own settings live in .env or the environment.
# Copy this file to docker/stack.env and fill in the secrets.

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# HMAC secret of the GitHub webhooks. Must match the secret configured on the
# repositories' webhooks; an empty secret disables verification, which only
# belongs in local debugging.
CITRACKER_WEBHOOK_SECRET=replace-me

# Static bearer shared by REST and MCP. Empty disables both (startup warns);
# a publicly reachable deployment must set it.
CITRACKER_API_KEY=replace-me

# Password of PostgreSQL. With the bundled overlay this is the password of the
# postgres:18 service (user citracker, database citracker).
CITRACKER_DB_PASSWORD=citracker

# ---------------------------------------------------------------------------
# Database coordinates
# ---------------------------------------------------------------------------
# Leave these at their defaults for the bundled postgres:18 overlay. For an
# external PostgreSQL, uncomment and point them at it.
# CITRACKER_DB_HOST=192.168.1.3
# CITRACKER_DB_PORT=16689
# CITRACKER_DB_USER=root
# CITRACKER_DB_NAME=citracker
# CITRACKER_DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# First-boot initialization (docker/init.d)
# ---------------------------------------------------------------------------
# The init service mounts ./docker/init.d read-only and runs its *.sh scripts
# once, when `rhosocial-github-ci-tracker-db is-initialized` reports no schema:
# 10-schema.sh creates the database and tables, 20-pat.sh handles the PAT below.
# auto (default) checks the database; force re-runs both; skip disables them.
# CITRACKER_INITDB=auto

# ---------------------------------------------------------------------------
# Fine-grained PAT (read by docker/init.d/20-pat.sh)
# ---------------------------------------------------------------------------
# When either value is non-empty, the first boot registers the token, or rotates
# it in place if the row already exists, and GitHub verifies it before the
# write. Leave both empty to create the schema only. To add a token after the
# first boot, run: docker compose run --rm -e CITRACKER_INITDB=force init
#
# Requires a fine-grained PAT with: Actions read/write, Metadata read, and
# optionally Administration read/write for webhook management.
CITRACKER_BOOTSTRAP_PAT=
# The file form keeps the token out of `docker inspect`; mount the file into
# the init container yourself (for example a compose secret or a read-only
# bind mount) and set this to its path inside the container.
# CITRACKER_BOOTSTRAP_PAT_FILE=/run/secrets/citracker-pat
CITRACKER_BOOTSTRAP_PAT_NAME=default
# Repository used to measure the repository-scoped Actions write permission,
# as owner/repo. Without it the capability is verified but stays unknown.
CITRACKER_BOOTSTRAP_PROBE_REPO=

# ---------------------------------------------------------------------------
# Published ports and public origin
# ---------------------------------------------------------------------------
# Host ports; the container ports are fixed at 18080 (webhook) and 8001 (MCP).
# CITRACKER_WEBHOOK_PORT_HOST=18080
# CITRACKER_MCP_PORT_HOST=8001

# Absolute origin used in MCP action URLs and as the default webhook callback.
# CITRACKER_PUBLIC_BASE_URL=https://ci.example.com:18080
# CITRACKER_WEBHOOK_URL=https://ci.example.com:18080/webhooks/github

# ---------------------------------------------------------------------------
# TLS (web container only)
# ---------------------------------------------------------------------------
# Certificate files are mounted from ./docker/certs to /certs. Set either value
# to an empty string when TLS terminates in a reverse proxy instead.
# CITRACKER_WEBHOOK_SSL_CERTFILE=/certs/fullchain.pem
# CITRACKER_WEBHOOK_SSL_KEYFILE=/certs/privkey.pem

# ---------------------------------------------------------------------------
# Legacy / manual operation
# ---------------------------------------------------------------------------
# skip runs no init scripts at all. Use it when the schema and credential are
# provisioned outside this compose project. CITRACKER_LEGACY=1 is equivalent.
# CITRACKER_INITDB=skip
CITRACKER_LEGACY=0

# Log level: DEBUG / INFO / WARNING / ERROR.
# CITRACKER_LOG_LEVEL=INFO
